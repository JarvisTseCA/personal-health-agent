# Copy to backend/.env and fill in. backend/.env is git-ignored.

# Jev API key from TypeSafe AI. Leave empty to use the local mock.
TYPESAFE_API_KEY=

# jev-latest (stable) or jev-preview (newest)
JEV_MODEL=jev-latest

# OpenAI API key for the model that writes Chat replies. Leave empty to use the placeholder reply.
OPENAI_API_KEY=

# Which model writes Chat replies (default: gpt-6-luna). Set it to try another model; no code change needed.
# CHAT_MODEL=gpt-6-luna

# Only if the key goes through another address than https://api.openai.com/v1 (for example a course gateway)
# OPENAI_BASE_URL=

# Where the SQLite file lives (default: backend/data/pha.db)
# PHA_DB_PATH=

# What the backend terminal prints for each suggestion:
# INFO (default) = one or two lines per step; DEBUG = also the full prompts and Jev answers
# LOG_LEVEL=INFO
