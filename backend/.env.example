# Copy to backend/.env and fill in. backend/.env is git-ignored.

# Jev API key from TypeSafe AI. Leave empty to use the local mock.
TYPESAFE_API_KEY=

# jev-latest (stable) or jev-preview (newest)
JEV_MODEL=jev-latest

# Where the SQLite file lives (default: backend/data/pha.db)
# PHA_DB_PATH=

# What the backend terminal prints for each suggestion:
# INFO (default) = one or two lines per step; DEBUG = also the full prompts and Jev answers
# LOG_LEVEL=INFO
