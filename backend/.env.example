# Copy to backend/.env and fill in. backend/.env is git-ignored.

# Jev API key from TypeSafe AI. Leave empty to use the local mock.
TYPESAFE_API_KEY=

# jev-latest (stable) or jev-preview (newest)
JEV_MODEL=jev-latest

# Where the SQLite file lives (default: backend/data/pha.db)
# PHA_DB_PATH=

# What the backend terminal prints for each suggestion:
# INFO (default) = one or two lines per step; DEBUG = also the full prompts and Jev answers
# LOG_LEVEL=INFO

# Real Fitbit data through the Google Health API (the Fitbit Web API was turned off Nov 2, 2026).
# Leave empty to keep the simulated Fitbit. Setup steps: docs/architecture.md ("Real Fitbit data").
GOOGLE_HEALTH_CLIENT_ID=
GOOGLE_HEALTH_CLIENT_SECRET=
# Must match an "Authorized redirect URI" on the OAuth client exactly.
# GOOGLE_HEALTH_REDIRECT_URI=http://localhost:8000/api/fitbit/callback
